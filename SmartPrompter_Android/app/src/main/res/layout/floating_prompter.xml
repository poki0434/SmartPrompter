<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#8C0F172A">

    <!-- 顶部拖动手柄 + 透明度 + 锁定 + 关闭 -->
    <LinearLayout
        android:id="@+id/floatDragHandle"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="#66000000"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⋮⋮ 悬浮提词"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="透"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:layout_marginStart="8dp" />

        <SeekBar
            android:id="@+id/floatOpacitySeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="90"
            android:progress="55" />

        <Button
            android:id="@+id/btnFloatLock"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="🔒 锁"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnFloatClose"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="28dp"
            android:layout_height="26dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textColor="#FDA4AF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 中间提词文本滚动区 -->
    <FrameLayout
        android:id="@+id/floatTextArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="52dp"
            android:background="#B3EF4444" />

        <ScrollView
            android:id="@+id/floatScrollContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/floatTextWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="48dp"
                android:paddingBottom="180dp">

                <TextView
                    android:id="@+id/tvFloatText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:lineSpacingMultiplier="1.35"
                    android:shadowColor="#FF000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 底部控制条 + 右下角缩放手柄 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="#73000000"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnFloatRestart"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="28dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="↺"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnFloatPlay"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="⏸"
                    android:textColor="#818CF8"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnFloatSpeedMinus"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="24dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="-"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvFloatSpeed"
                    android:layout_width="22dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="35"
                    android:textColor="#818CF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnFloatSpeedPlus"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="24dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnFloatFontMinus"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="26dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="A-"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnFloatFontPlus"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="26dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="A+"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/btnFloatAlign"
                    android:layout_width="28dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_align_center"
                    android:contentDescription="对齐" />

                <Button
                    android:id="@+id/btnFloatAi"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="26dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="Ai"
                    android:textAllCaps="false"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnFloatOrient"
                    android:layout_width="28dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_orientation"
                    android:contentDescription="旋转尺寸" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/floatResizeHandle"
            android:layout_width="22dp"
            android:layout_height="26dp"
            android:gravity="bottom|end"
            android:paddingEnd="2dp"
            android:paddingBottom="1dp"
            android:text="◢"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- 1. 一级界面：草稿列表 (layoutDraftList) -->
    <LinearLayout
        android:id="@+id/layoutDraftList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="智能提词器 · 我的草稿"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDraftCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="共 1 篇提词文稿"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnNewDraft"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="+ 新建草稿"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4F46E5" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/draftListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 2. 二级界面：编辑与参数设置 (layoutEditor) -->
    <LinearLayout
        android:id="@+id/layoutEditor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <Button
                android:id="@+id/btnBackToDrafts"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="← 草稿"
                android:textColor="#CBD5E1"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="编辑提词文稿"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLaunchPrompter"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="开启提词 ▶"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4F46E5" />
        </LinearLayout>

        <!-- 草稿标题输入 -->
        <EditText
            android:id="@+id/etDraftTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="12dp"
            android:layout_marginBottom="10dp"
            android:hint="输入草稿标题（如：文档1）..."
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 蓝牙状态卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎧 耳机：单击=启停 · 滑音量=调速(±10) | 屏幕：轻点=启停 · 上下滑=调位置"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvRemoteSignalBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 蓝牙耳机监听已就绪"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 台词内容输入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvWordCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 字 · 约 0 秒"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnLoadSample"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="载入示例"
                    android:textColor="#818CF8"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnClearScript"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="清空"
                    android:textColor="#F43F5E"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etScript"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:gravity="top|start"
                android:hint="在此输入或粘贴提词内容..."
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="15sp"
                android:inputType="textMultiLine"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- 底部参数滑块 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="滚动速度:"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekSpeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="45" />

                <TextView
                    android:id="@+id/tvSpeedValue"
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:text="45 px/s"
                    android:textColor="#818CF8"
                    android:textSize="12sp"
                    android:gravity="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="字体大小:"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekFontSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="90"
                    android:progress="48" />

                <TextView
                    android:id="@+id/tvFontSizeValue"
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:text="48 sp"
                    android:textColor="#818CF8"
                    android:textSize="12sp"
                    android:gravity="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <CheckBox
                    android:id="@+id/cbMirror"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="镜像模式(水平+180°)"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/cbFocusLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="对齐参考线"
                    android:checked="true"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 三级界面：全屏提词器播放视图 (layoutPrompter) -->
    <FrameLayout
        android:id="@+id/layoutPrompter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/prompterScrollContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/framePrompterContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="220dp"
                android:paddingBottom="550dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <TextView
                    android:id="@+id/tvPrompterText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="#FFFFFF"
                    android:textSize="48sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <View
            android:id="@+id/viewFocusLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#EF4444"
            android:layout_marginTop="200dp" />

        <TextView
            android:id="@+id/tvPrompterHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="32dp"
            android:background="#CC1E293B"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:textColor="#818CF8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/layoutFloatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="28dp"
            android:background="#E61E293B"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutFloatingBarInner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnPrompterExit"
                    android:layout_width="30dp"
                    android:layout_height="34dp"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="退出" />

                <ImageButton
                    android:id="@+id/btnPrompterRestart"
                    android:layout_width="30dp"
                    android:layout_height="34dp"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_revert"
                    android:contentDescription="重开" />

                <ImageButton
                    android:id="@+id/btnPrompterPlayPause"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="3dp"
                    android:scaleType="centerInside"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_pause"
                    android:contentDescription="播放暂停" />

                <Button
                    android:id="@+id/btnPrompterSpeedMinus"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="26dp"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="-"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvPrompterSpeedIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="22dp"
                    android:gravity="center"
                    android:text="45"
                    android:textColor="#818CF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPrompterSpeedPlus"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="26dp"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnPrompterFontMinus"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="28dp"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="A-"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnPrompterFontPlus"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="28dp"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="A+"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/btnPrompterMirror"
                    android:layout_width="30dp"
                    android:layout_height="34dp"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_mirror"
                    android:contentDescription="镜像" />

                <ImageButton
                    android:id="@+id/btnPrompterAlign"
                    android:layout_width="30dp"
                    android:layout_height="34dp"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_align_center"
                    android:contentDescription="对齐方式" />

                <ImageButton
                    android:id="@+id/btnPrompterOrientation"
                    android:layout_width="30dp"
                    android:layout_height="34dp"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_orientation"
                    android:contentDescription="横竖屏" />
            </LinearLayout>
        </HorizontalScrollView>
    </FrameLayout>
</FrameLayout>
